{
  "name": "@cris1670/content-kit",
  "version": "0.2.0",
  "type": "module",
  "description": "Offline browser editing kit for static and i18n websites.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cris1670/content-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Cris1670/content-kit/issues"
  },
  "homepage": "https://github.com/Cris1670/content-kit#readme",
  "keywords": [
    "content",
    "i18n",
    "next-intl",
    "translations",
    "chrome-extension"
  ],
  "bin": {
    "content-kit": "bin/content-kit.mjs"
  },
  "main": "./browser.mjs",
  "types": "./browser.d.mts",
  "exports": {
    ".": "./browser.mjs",
    "./browser": "./browser.mjs"
  },
  "files": [
    "bin/",
    "browser.d.mts",
    "browser.mjs",
    "src/",
    "content-tool.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "init": "node bin/content-kit.mjs init",
    "apply-edits": "node bin/content-kit.mjs apply-edits",
    "check": "npm run format:check && npm run lint && npm run test:unit && npm run validate",
    "audit:ci": "npm audit --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run check",
    "test:unit": "node --test",
    "validate": "node scripts/check.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "eslint": "10.3.0",
    "eslint-plugin-security": "4.0.0",
    "prettier": "3.8.3"
  }
}
